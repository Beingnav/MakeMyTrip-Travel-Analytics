        "partitions": [
          {
            "name": "Users",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(FolderPath & \"\\Users.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Typed = Table.TransformColumnTypes(Headers, {{\"UserID\", Int64.Type}, {\"FirstName\", type text}, {\"LastName\", type text}, {\"Email\", type text}, {\"Password\", type text}, {\"PhoneNumber\", type text}, {\"RegistrationDate\", type datetime}}),\n    Dropped = Table.RemoveColumns(Typed, {\"Password\"}),\n    S1 = Table.AddColumn(Dropped, \"Registration Cohort\", each Date.ToText(Date.From([RegistrationDate]), [Format=\"MMM yyyy\", Culture=\"en-US\"]), type text),\n    S2 = Table.AddColumn(S1, \"Registration Cohort Sort\", each Date.Year([RegistrationDate])*100 + Date.Month([RegistrationDate]), Int64.Type)\nin\n    S2"
            }
          }
        ]
      },
