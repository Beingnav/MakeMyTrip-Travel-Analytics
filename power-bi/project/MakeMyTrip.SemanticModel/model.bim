      {
        "name": "_Measures",
        "lineageTag": "22152971-3dd9-40ce-a798-f9014ba5d8c0",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "string",
            "sourceColumn": "Placeholder",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "165ea916-52b4-494d-9d6e-6fe449389589"
          }
        ],
        "measures": [
          {
            "name": "Total Bookings",
            "expression": "DISTINCTCOUNT ( Bookings[BookingID] )",
            "formatString": "#,0",
            "lineageTag": "1c0e5508-adc8-4690-bf5a-01842fdab65a",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Booking Value",
            "expression": "SUM ( Bookings[TotalPrice] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "dc2dbe47-8114-4612-a55d-7160fe462d05",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Avg Booking Value",
            "expression": "DIVIDE ( [Booking Value], [Total Bookings] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "d12f194b-0564-4b5d-b5fb-955c99b1a00e",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Median Booking Value",
            "expression": "MEDIANX ( Bookings, Bookings[TotalPrice] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "68c8609c-6811-4073-89d5-029656156fd6",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Passengers Carried",
            "expression": "SUM ( FlightBookings[Passengers] ) + SUM ( BusBookings[Passengers] ) + SUM ( TrainBookings[Passengers] )",
            "formatString": "#,0",
            "lineageTag": "9480443c-7e3b-4400-a102-b7c607970e54",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Rooms Booked",
            "expression": "SUM ( HotelBookings[NumberOfRooms] )",
            "formatString": "#,0",
            "lineageTag": "1753ecc3-90a7-427c-850c-99525e62127d",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Gross Revenue",
            "expression": "SUM ( Payments[PaymentAmount] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "feace0be-8e80-42ed-82e4-1902be3a684d",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Refunded Revenue",
            "expression": "CALCULATE ( [Gross Revenue], Bookings[Status] = \"Refunded\" )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "fd0c3e53-0c03-41a7-a214-ad3d43c8f902",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Net Revenue",
            "expression": "[Gross Revenue] - [Refunded Revenue]",
            "formatString": "\"₹\"#,0",
            "lineageTag": "a2adccd2-5c53-4695-bdbe-644a35bad75c",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Refund Leakage %",
            "expression": "DIVIDE ( [Refunded Revenue], [Gross Revenue] )",
            "formatString": "0.0%",
            "lineageTag": "4edc1a38-adca-4c3d-9992-ff5cbd16ce77",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Revenue Realisation %",
            "expression": "DIVIDE ( [Net Revenue], [Booking Value] )",
            "formatString": "0.0%",
            "lineageTag": "84a482ab-e4c5-4d29-a9e3-eecd95a030cb",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Revenue per Booking",
            "expression": "DIVIDE ( [Net Revenue], [Total Bookings] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "bfd6b61e-c1de-4489-a442-29bafaece1e4",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Revenue per Active User",
            "expression": "DIVIDE ( [Net Revenue], DISTINCTCOUNT ( Bookings[UserID] ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "98f85b29-6c5b-45e3-997b-a3afa149c117",
            "displayFolder": "02 Revenue"
          },
          {
            "name": "Completed Bookings",
            "expression": "CALCULATE ( [Total Bookings], Bookings[Status] = \"Completed\" )",
            "formatString": "#,0",
            "lineageTag": "02d99f89-e9bb-4aee-ae94-46ffb323faa1",
            "displayFolder": "03 Status"
          },
          {
            "name": "Confirmed Bookings",
            "expression": "CALCULATE ( [Total Bookings], Bookings[Status] = \"Confirmed\" )",
            "formatString": "#,0",
            "lineageTag": "1c91488a-94f4-4f83-8ebb-d74db8e556c8",
            "displayFolder": "03 Status"
          },
          {
            "name": "Pending Bookings",
            "expression": "CALCULATE ( [Total Bookings], Bookings[Status] = \"Pending\" )",
            "formatString": "#,0",
            "lineageTag": "441caed6-9c12-4283-9760-7efd4f4d097e",
            "displayFolder": "03 Status"
          },
          {
            "name": "Cancelled Bookings",
            "expression": "CALCULATE ( [Total Bookings], Bookings[Status] = \"Cancelled\" )",
            "formatString": "#,0",
            "lineageTag": "3ec64109-5eb8-447f-ab5a-822f06cf8a60",
            "displayFolder": "03 Status"
          },
          {
            "name": "Refunded Bookings",
            "expression": "CALCULATE ( [Total Bookings], Bookings[Status] = \"Refunded\" )",
            "formatString": "#,0",
            "lineageTag": "fef272a1-3931-4104-abd8-d96a23fe5c15",
            "displayFolder": "03 Status"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE ( [Cancelled Bookings], [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "a5334274-81cb-448b-951a-3ae7dde3bcfd",
            "displayFolder": "03 Status"
          },
          {
            "name": "Refund Rate",
            "expression": "DIVIDE ( [Refunded Bookings], [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "87c52e08-13bd-4c63-b645-821ecfb4d9f0",
            "displayFolder": "03 Status"
          },
          {
            "name": "Failed Booking Rate",
            "expression": "DIVIDE ( [Cancelled Bookings] + [Refunded Bookings], [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "6c4a35e6-969b-4f19-9411-a769f487f41d",
            "displayFolder": "03 Status"
          },
          {
            "name": "Pending Rate",
            "expression": "DIVIDE ( [Pending Bookings], [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "6e293ef4-cc8f-45f2-8ade-91d0cb2f7e35",
            "displayFolder": "03 Status"
          },
          {
            "name": "Value at Risk",
            "expression": "CALCULATE ( [Booking Value], Bookings[Status] IN { \"Pending\", \"Cancelled\" } )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "b2d6e327-9098-4172-8192-37578eece305",
            "displayFolder": "03 Status"
          },
          {
            "name": "Total Users",
            "expression": "DISTINCTCOUNT ( Users[UserID] )",
            "formatString": "#,0",
            "lineageTag": "be6dd6f4-1d0d-4868-9cef-2abff4962a02",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Active Users",
            "expression": "DISTINCTCOUNT ( Bookings[UserID] )",
            "formatString": "#,0",
            "lineageTag": "76185ab3-7846-44df-ade4-e54c24aba400",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Activation Rate",
            "expression": "DIVIDE ( [Active Users], [Total Users] )",
            "formatString": "0.0%",
            "lineageTag": "743cb99c-f0a6-4298-86fe-c994586d4b05",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Bookings per Active User",
            "expression": "DIVIDE ( [Total Bookings], [Active Users] )",
            "formatString": "#,0.00",
            "lineageTag": "2ccf8708-9734-4611-9c78-5aad35011e7f",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Repeat Users",
            "expression": "COUNTROWS ( FILTER ( VALUES ( Bookings[UserID] ), CALCULATE ( COUNTROWS ( Bookings ) ) > 1 ) )",
            "formatString": "#,0",
            "lineageTag": "6166cbe5-d354-4e74-9957-464b21fb2d17",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Repeat Rate",
            "expression": "DIVIDE ( [Repeat Users], [Active Users] )",
            "formatString": "0.0%",
            "lineageTag": "a43402a7-6a82-44e8-a365-257413478235",
            "displayFolder": "04 Customers"
          },
          {
            "name": "One-Time Users",
            "expression": "[Active Users] - [Repeat Users]",
            "formatString": "#,0",
            "lineageTag": "fd829bae-aceb-4547-b8ae-d23de9b97a23",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Customer Lifetime Value",
            "expression": "DIVIDE ( [Net Revenue], [Active Users] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "57bc9485-d7f0-41d8-b903-a452a2cf4975",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Avg Days To First Booking",
            "expression": "AVERAGEX ( FILTER ( VALUES ( Users[UserID] ), NOT ISBLANK ( CALCULATE ( COUNTROWS ( Bookings ) ) ) ), VAR FirstBooking = CALCULATE ( MIN ( Bookings[BookingDateTime] ) ) VAR RegDate = CALCULATE ( MIN ( Users[RegistrationDate] ) ) RETURN DATEDIFF ( RegDate, FirstBooking, DAY ) )",
            "formatString": "#,0",
            "lineageTag": "8d0a6565-6d7c-4a8d-b168-34e047bb27b9",
            "displayFolder": "04 Customers"
          },
          {
            "name": "New Customers",
            "expression": "COUNTROWS ( FILTER ( VALUES ( Bookings[UserID] ), VAR FirstEver = CALCULATE ( MIN ( Bookings[BookingDate] ), ALL ( DateTable ) ) RETURN FirstEver >= MIN ( DateTable[Date] ) && FirstEver <= MAX ( DateTable[Date] ) ) )",
            "formatString": "#,0",
            "lineageTag": "3e654204-bea5-4b1a-b95b-f7339829ab35",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Returning Customers",
            "expression": "[Active Users] - [New Customers]",
            "formatString": "#,0",
            "lineageTag": "9fe7e6c1-9a35-42b9-8332-ce7c427f300e",
            "displayFolder": "04 Customers"
          },
          {
            "name": "Avg Rating",
            "expression": "AVERAGE ( Reviews[Rating] )",
            "formatString": "#,0.00",
            "lineageTag": "b3e96e45-0ec4-4013-891e-f8563e39e9ee",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Review Count",
            "expression": "COUNTROWS ( Reviews )",
            "formatString": "#,0",
            "lineageTag": "8d5c854e-6792-4292-bcb7-fc92a933287c",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Review Coverage",
            "expression": "DIVIDE ( DISTINCTCOUNT ( Reviews[BookingID] ), [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "4ddd5cb1-46e9-46fa-8f06-7c548f92063a",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Promoters",
            "expression": "CALCULATE ( [Review Count], Reviews[Rating] >= 4 )",
            "formatString": "#,0",
            "lineageTag": "7a74ae7a-568f-4892-b6c0-52b4c490beb2",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Passives",
            "expression": "CALCULATE ( [Review Count], Reviews[Rating] = 3 )",
            "formatString": "#,0",
            "lineageTag": "2c6ab046-b714-4703-a0cd-964f5fa66c6b",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Detractors",
            "expression": "CALCULATE ( [Review Count], Reviews[Rating] <= 2 )",
            "formatString": "#,0",
            "lineageTag": "541cd68b-6ee9-4ccc-8bdb-ac9982e1527f",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Promoter Share",
            "expression": "DIVIDE ( [Promoters], [Review Count] )",
            "formatString": "0.0%",
            "lineageTag": "3e93dbb7-6a81-4b6a-aa40-b59ec1b1ddea",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Satisfaction Score",
            "expression": "DIVIDE ( [Promoters] - [Detractors], [Review Count] ) * 100",
            "formatString": "#,0",
            "lineageTag": "7032610c-7144-40da-abcf-fc889d2ae299",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Rating vs Average",
            "expression": "[Avg Rating] - CALCULATE ( [Avg Rating], ALL ( Bookings[ServiceType] ) )",
            "formatString": "#,0.00",
            "lineageTag": "21522f3d-7239-4940-b598-5990ae4cb314",
            "displayFolder": "05 Reviews"
          },
          {
            "name": "Coupons Redeemed",
            "expression": "DISTINCTCOUNT ( DiscountCoupons[BookingID] )",
            "formatString": "#,0",
            "lineageTag": "50e5b131-adbd-407b-8d9b-45e9d1483953",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Coupon Redemption Rate",
            "expression": "DIVIDE ( [Coupons Redeemed], [Total Bookings] )",
            "formatString": "0.0%",
            "lineageTag": "beb57413-a684-423e-83fc-13fe0d8af131",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Avg Discount %",
            "expression": "AVERAGE ( DiscountCoupons[DiscountPercent] ) / 100",
            "formatString": "0.0%",
            "lineageTag": "250fbac1-572d-4ca9-b82b-4ec15527dbcd",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Estimated Discount Value",
            "expression": "SUMX ( DiscountCoupons, RELATED ( Bookings[TotalPrice] ) * DiscountCoupons[DiscountPercent] / 100 )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "87f42d8f-6e56-4890-ae3b-0e0be13e8115",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Avg Value with Coupon",
            "expression": "CALCULATE ( [Avg Booking Value], FILTER ( Bookings, NOT ISBLANK ( CALCULATE ( COUNTROWS ( DiscountCoupons ) ) ) ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "fcff42d6-bd5c-414b-91bb-a3db18097877",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Avg Value without Coupon",
            "expression": "CALCULATE ( [Avg Booking Value], FILTER ( Bookings, ISBLANK ( CALCULATE ( COUNTROWS ( DiscountCoupons ) ) ) ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "5428ae93-96fd-42a0-9f9d-f7e37bb65298",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Coupon Basket Lift %",
            "expression": "DIVIDE ( [Avg Value with Coupon] - [Avg Value without Coupon], [Avg Value without Coupon] )",
            "formatString": "0.0%",
            "lineageTag": "40ac393d-5123-4d7f-9659-da7353315bbd",
            "displayFolder": "06 Coupons"
          },
          {
            "name": "Net Revenue LY",
            "expression": "CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( DateTable[Date] ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "e80c6dc0-a9ae-465d-8077-b0b178edb566",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue YoY %",
            "expression": "DIVIDE ( [Net Revenue] - [Net Revenue LY], [Net Revenue LY] )",
            "formatString": "0.0%",
            "lineageTag": "451d636c-ee34-412b-b6bf-05c6312bd84d",
            "displayFolder": "07 Time"
          },
          {
            "name": "Bookings LY",
            "expression": "CALCULATE ( [Total Bookings], SAMEPERIODLASTYEAR ( DateTable[Date] ) )",
            "formatString": "#,0",
            "lineageTag": "c3f8dc41-70c3-433a-a8db-48c8e364fe06",
            "displayFolder": "07 Time"
          },
          {
            "name": "Bookings YoY %",
            "expression": "DIVIDE ( [Total Bookings] - [Bookings LY], [Bookings LY] )",
            "formatString": "0.0%",
            "lineageTag": "246e9489-9997-42cf-9b37-810c02ba2a51",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD ( [Net Revenue], DateTable[Date] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "a7d44b0b-1816-423e-bda0-cdb80b0e81e2",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue MTD",
            "expression": "TOTALMTD ( [Net Revenue], DateTable[Date] )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "b4d1a0ac-547b-452f-b81c-5a439e451d09",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue YTD LY",
            "expression": "CALCULATE ( [Revenue YTD], SAMEPERIODLASTYEAR ( DateTable[Date] ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "f18859bd-2ae8-4086-aa1c-a3a346f58dfd",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue Rolling 3M",
            "expression": "CALCULATE ( [Net Revenue], DATESINPERIOD ( DateTable[Date], MAX ( DateTable[Date] ), -3, MONTH ) )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "d1b03f17-4af8-4cdb-9cd5-59f529eb82bb",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue 3M Moving Avg",
            "expression": "DIVIDE ( [Revenue Rolling 3M], 3 )",
            "formatString": "\"₹\"#,0",
            "lineageTag": "872e89fe-c806-4487-b929-4b257a618330",
            "displayFolder": "07 Time"
          },
          {
            "name": "Revenue Share of Total",
            "expression": "DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALLSELECTED ( Bookings[ServiceType] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "b5449379-0022-486c-875e-789e79cc92f1",
            "displayFolder": "08 Mix"
          },
          {
            "name": "Booking Share of Total",
            "expression": "DIVIDE ( [Total Bookings], CALCULATE ( [Total Bookings], ALLSELECTED ( Bookings[ServiceType] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "f3bb2949-0e8e-4716-b075-71531ca814af",
            "displayFolder": "08 Mix"
          },
          {
            "name": "Service Rank by Revenue",
            "expression": "RANKX ( ALLSELECTED ( Bookings[ServiceType] ), [Net Revenue],, DESC, DENSE )",
            "formatString": "#,0",
            "lineageTag": "b49d068d-e04e-4822-b96d-962bdddf82d3",
            "displayFolder": "08 Mix"
          }
        ],
