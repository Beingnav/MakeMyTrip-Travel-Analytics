        "partitions": [
          {
            "name": "Bookings",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(FolderPath & \"\\Bookings.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Typed = Table.TransformColumnTypes(Headers, {{\"BookingID\", Int64.Type}, {\"UserID\", Int64.Type}, {\"BookingDateTime\", type datetime}, {\"TotalPrice\", type number}, {\"Status\", type text}, {\"ServiceType\", type text}}),\n    S1 = Table.AddColumn(Typed, \"BookingDate\", each DateTime.From(Date.From([BookingDateTime])), type datetime),\n    S2 = Table.AddColumn(S1, \"Status Order\", each if [Status]=\"Completed\" then 1 else if [Status]=\"Confirmed\" then 2 else if [Status]=\"Pending\" then 3 else if [Status]=\"Refunded\" then 4 else 5, Int64.Type),\n    S3 = Table.AddColumn(S2, \"Price Band\", each if [TotalPrice] < 2500 then \"1. Under 2.5K\" else if [TotalPrice] < 10000 then \"2. 2.5K - 10K\" else if [TotalPrice] < 25000 then \"3. 10K - 25K\" else if [TotalPrice] < 75000 then \"4. 25K - 75K\" else \"5. 75K+\", type text),\n    S4 = Table.AddColumn(S3, \"Booking Month Sort\", each Date.Year([BookingDateTime])*100 + Date.Month([BookingDateTime]), Int64.Type)\nin\n    S4"
            }
          }
        ]
